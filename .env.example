# Container port on the host. Reach it at http://SERVER-IP:3000.
PORT=3000
BIND_ADDRESS=0.0.0.0
# Existing writable folder, or the included vault directory.
VAULT_PATH=./vault
# Linux: match the output of `id -u` and `id -g`.
LOCAL_UID=1000
LOCAL_GID=1000

# Optional accounts; create an administrator before enabling required mode.
AUTH_MODE=shared
# Single-user local/LAN access: AUTH_MODE=local automatically uses this administrator.
# AUTH_MODE=single-user automatically uses this administrator on every connection,
# including Tailscale. Everyone who can reach the server gets full workspace access.
# Do not use local mode behind a public reverse proxy.
LOCAL_USER_NAME=George
# Set true when HTTPS is terminated by a trusted reverse proxy.
COOKIE_SECURE=false
# Native HTTPS override reads these host files:
# TLS_CERT_FILE=/absolute/path/fullchain.pem
# TLS_KEY_FILE=/absolute/path/privkey.pem

# Integrations work with local/single-user mode or a signed-in administrator in required mode.
# Register the callbacks shown in README.md. Never put secrets in browser code.
# APP_ORIGIN=https://pencils.example.test
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# MIRO_CLIENT_ID=
# MIRO_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=organizations
# Native Node: OBSIDIAN_ROOT=/absolute/path/to/notes
# Docker: add an explicit notes bind mount and set its path inside the container:
# OBSIDIAN_CONTAINER_ROOT=/notes

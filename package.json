{
  "name": "pencils",
  "version": "0.20.72",
  "private": true,
  "type": "module",
  "description": "An offline, Markdown-backed project workspace",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "predev": "npm run build:editor && npm run build:server",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "e2e": "playwright test --project=chromium",
    "e2e:affected": "node scripts/affected.mjs --run",
    "check": "npm run typecheck && node test/check.mjs",
    "account": "node server/account.js",
    "test:release": "npm run check && npm test && RELEASE=1 playwright test && playwright test --project=docker",
    "index:rebuild": "node server/rebuild-index.js",
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prestart": "npm run build:server",
    "pretest": "npm run build:server",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "5.11.2",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "marked-footnote": "^1.4.0",
    "mermaid": "^12.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}

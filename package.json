{
  "name": "pencils",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "An offline, Markdown-backed project workspace",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs",
    "check": "node test/check.mjs",
    "test:upgrade": "node test/upgrade-browser.mjs",
    "account": "node server/account.js",
    "test:canvas": "node test/canvas-browser.mjs",
    "test:canvas-performance": "node test/canvas-performance.mjs",
    "test:canvas-controls": "node test/canvas-controls.mjs",
    "test:personal": "node test/personal-browser.mjs",
    "test:project-layout": "node test/project-layout.mjs",
    "test:board-layout": "node test/board-layout.mjs",
    "test:drag-feedback": "node test/drag-feedback.mjs",
    "test:selection-toolbar": "node test/selection-toolbar.mjs",
    "test:board-editor": "node test/board-editor.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "marked": "^18.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "prettier": "^3.9.10"
  }
}
